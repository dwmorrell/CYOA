{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dwmorrell/CYOA/schemas/story.schema.json",
  "title": "CYOA Story",
  "description": "A branching, dyslexia-informed reading adventure. Content only: publication status lives in the production job, never in the story file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "version", "metadata", "literacy", "start", "items", "clues", "passages"],
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "idList": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
    "learningTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["comprehension", "inference", "sequencing", "vocabulary", "detail", "engagement"] }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "items": { "$ref": "#/definitions/idList" },
        "clues": { "$ref": "#/definitions/idList" },
        "flags": { "$ref": "#/definitions/idList" },
        "notFlags": { "$ref": "#/definitions/idList" }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "addItems": { "$ref": "#/definitions/idList" },
        "removeItems": { "$ref": "#/definitions/idList" },
        "addClues": { "$ref": "#/definitions/idList" },
        "setFlags": { "$ref": "#/definitions/idList" }
      }
    },
    "collectible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "description": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "target"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 90 },
        "target": { "$ref": "#/definitions/id" },
        "requires": { "$ref": "#/definitions/condition" },
        "effects": { "$ref": "#/definitions/effects" },
        "lockedHint": { "type": "string", "maxLength": 90 },
        "learningTargets": { "$ref": "#/definitions/learningTargets" }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paragraphs", "choices"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "maxLength": 60 },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 600 }
        },
        "effects": { "$ref": "#/definitions/effects" },
        "learningTargets": { "$ref": "#/definitions/learningTargets" },
        "choices": { "type": "array", "maxItems": 4, "items": { "$ref": "#/definitions/choice" } },
        "ending": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "title"],
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "kind": { "enum": ["triumph", "bittersweet", "setback"] },
            "title": { "type": "string", "minLength": 1, "maxLength": 60 }
          }
        }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/definitions/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "integer", "minimum": 1 },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "previousStoryId": { "$ref": "#/definitions/id" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genre", "theme", "premise", "estimatedMinutes", "authorship", "createdAt"],
      "properties": {
        "genre": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "premise": { "type": "string", "minLength": 1, "maxLength": 400 },
        "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
        "authorship": {
          "type": "object",
          "additionalProperties": false,
          "required": ["narrative", "origin"],
          "properties": {
            "narrative": { "type": "string", "minLength": 1 },
            "origin": { "enum": ["human", "ai-assisted", "ai-generated"] }
          }
        },
        "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "literacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetConcepts", "wordSets", "review"],
      "properties": {
        "targetConcepts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "wordSets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "words", "minOccurrences"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "label": { "type": "string", "minLength": 1 },
              "concept": { "type": "string" },
              "words": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" }
              },
              "minOccurrences": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["pending", "passed", "changes-requested"] },
            "reviewer": { "type": "string" },
            "reviewerKind": { "enum": ["human", "ai-agent"] },
            "date": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "start": { "$ref": "#/definitions/id" },
    "items": { "type": "array", "items": { "$ref": "#/definitions/collectible" } },
    "clues": { "type": "array", "items": { "$ref": "#/definitions/collectible" } },
    "passages": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/passage" } },
    "glossary": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["syllables"],
        "properties": {
          "syllables": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "hint": { "type": "string", "maxLength": 120 },
          "definition": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
